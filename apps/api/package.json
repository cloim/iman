{
  "name": "@iman/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "dev:live": "tsx watch --env-file=.env.live.local src/index.ts",
    "start": "node dist/index.js",
    "build": "node build.mjs",
    "migrate": "tsx --env-file=.env.local src/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.3.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@iman/core": "workspace:*",
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
